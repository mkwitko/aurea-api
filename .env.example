NODE_ENV=development

DATABASE_URL=postgresql://aurea:aurea@localhost:5434/aurea?schema=public

API_HOST=0.0.0.0
API_PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aurea-uploads
R2_PUBLIC_URL=https://cdn.youraurea.com

REDIS_URL=redis://localhost:6380
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_PROVIDER_API_KEY=
AI_MODEL_TIER1=
AI_MODEL_TIER2=
AI_WORKER_ENABLED=true
AI_WORKER_CONCURRENCY=2
AI_CALL_TIMEOUT_MS=60000
AI_RUN_TIMEOUT_MS=180000
# Cofre das chaves BYOK. 32 bytes em base64: openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=

# Web search for the Research Agent. Without it, research runs are refused
# before any credits are spent.
TAVILY_API_KEY=

# Tracing (Langfuse), self-hosted — see docs/development/tracing.md. All three
# required together; missing any one disables tracing (silent no-op).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=

# Stripe (test mode). Chave secreta ausente desliga as rotas de billing;
# webhook secret ausente não registra a rota do webhook.
# Em desenvolvimento: stripe listen --forward-to localhost:3337/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_1Ty1LkAZf2sIrmumUQ9PZCQD
STRIPE_PRICE_GROWTH=price_1Ty1M0AZf2sIrmumF49lbgtg
STRIPE_PRICE_SCALE=price_1Ty1MIAZf2sIrmumPc0MybUw
STRIPE_PRICE_PACK_SMALL=price_1Ty1MfAZf2sIrmum1IO1C11g
STRIPE_PRICE_PACK_MEDIUM=price_1Ty1MiAZf2sIrmumJ6LZ0AFL
STRIPE_PRICE_PACK_LARGE=price_1Ty1N1AZf2sIrmumVF5nwt4V

# Base do success/cancel do checkout e do retorno do portal
APP_URL=http://localhost:5173

# Publicação em redes sociais (Post for Me). Sem a chave, as rotas sociais
# respondem 503 em vez de falharem no meio de uma publicação.
POST_FOR_ME_API_KEY=
# Só para apontar para outro host; o padrão já é o de produção.
# POST_FOR_ME_BASE_URL=https://api.postforme.dev

# Local Langfuse stack (docker-compose.yml). Generate each with: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
