NODE_ENV=production

# --- Postgres (compose service name is the host) ---
POSTGRES_USER=aurea
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=aurea
DATABASE_URL=postgresql://aurea:CHANGE_ME_strong_password@postgres:5432/aurea?schema=public

# --- API ---
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info
# The Cloudflare Pages URL of the frontend (for CORS):
CORS_ORIGIN=https://app.yourdomain.com

# --- Domain fronted by Caddy (API only) ---
API_DOMAIN=api.yourdomain.com

# --- Auth (generate: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Frontend base URL (checkout success/cancel and billing portal return) ---
# NÃO é o endereço da API. Em produção um localhost aqui derruba o boot: um
# APP_URL esquecido redirecionaria quem acabou de pagar para a máquina de alguém.
APP_URL=https://app.yourdomain.com

# --- Stripe ---
# Sem STRIPE_SECRET_KEY as rotas de billing não existem; sem
# STRIPE_WEBHOOK_SECRET a rota do webhook não é registrada. Os price ids não são
# segredo (são os do modo live desta conta); as duas chaves são.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STARTER=price_CHANGE_ME
STRIPE_PRICE_GROWTH=price_CHANGE_ME
STRIPE_PRICE_SCALE=price_CHANGE_ME
STRIPE_PRICE_PACK_SMALL=price_CHANGE_ME
STRIPE_PRICE_PACK_MEDIUM=price_CHANGE_ME
STRIPE_PRICE_PACK_LARGE=price_CHANGE_ME

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=aurea-uploads
R2_PUBLIC_URL=https://cdn.youraurea.com
